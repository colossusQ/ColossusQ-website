# ==============================================================================
# Colossus Q - Production Apache / Cloudways Configuration (.htaccess)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Security & Directory Browsing
# ------------------------------------------------------------------------------
# Disable directory index browsing
Options -Indexes -MultiViews

# Block access to hidden files and directories (like .git, .env)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule "(^|/)\.(?!well-known)" - [F]
</IfModule>

# Block access to development, package, and configuration files
<FilesMatch "^(package\.json|package-lock\.json|wrangler\.jsonc|server\.js|README\.md|README\.txt|vercel\.json|\.vercelignore|\.assetsignore|\.gitattributes)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# ------------------------------------------------------------------------------
# 2. Canonical HTTPS Redirection
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteCond %{HTTP_HOST} ^(?:www\.)?colossusq\.com$ [NC]
  RewriteRule ^ https://colossusq.com%{REQUEST_URI} [L,R=301]
</IfModule>

# ------------------------------------------------------------------------------
# 3. Clean URLs & Routing
# ------------------------------------------------------------------------------
<IfModule mod_rewrite.c>
  # Ensure trailing slash on directories if requested without one
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^(.*[^/])$ /$1/ [L,R=301]

  # Custom 404 error routing
  ErrorDocument 404 /404.html
</IfModule>

# ------------------------------------------------------------------------------
# 4. MIME Types Configuration
# ------------------------------------------------------------------------------
<IfModule mod_mime.c>
  AddType text/html;charset=utf-8 .html
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json .webmanifest
  AddType image/svg+xml .svg .svgz
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType video/mp4 .mp4
</IfModule>

# ------------------------------------------------------------------------------
# 5. GZIP & Deflate Compression
# ------------------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/plain
  AddOutputFilterByType DEFLATE text/xml
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/x-javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE application/xhtml+xml
  AddOutputFilterByType DEFLATE application/rss+xml
  AddOutputFilterByType DEFLATE application/atom_xml
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE font/ttf
  AddOutputFilterByType DEFLATE font/otf
  AddOutputFilterByType DEFLATE font/opentype
</IfModule>

# ------------------------------------------------------------------------------
# 6. Browser Caching (Expires & Cache-Control)
# ------------------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML: Always revalidate to ensure fresh deployments
  ExpiresByType text/html "access plus 0 seconds"

  # CSS, JavaScript
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # Images
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video (Hero background)
  ExpiresByType video/mp4 "access plus 1 year"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"

  # Data & Manifests
  ExpiresByType application/json "access plus 1 day"
  ExpiresByType application/manifest+json "access plus 1 week"
  ExpiresByType text/xml "access plus 1 day"
</IfModule>

# ------------------------------------------------------------------------------
# 7. Enterprise Security Headers
# ------------------------------------------------------------------------------
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"

  # Cache-Control overrides
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, must-revalidate, public"
  </FilesMatch>

  <FilesMatch "\.(css|js|woff2|woff|ttf|svg|jpg|jpeg|png|webp|ico|mp4)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>
</IfModule>
